    "startLine": 7,
    "endLine": 30,
    "content": "def find_trellis_root(start: str | Path) -> Path | None:     \"\"\"Return the nearest valid Trellis ancestor, including the filesystem root.     A cache/empty marker is not a workspace. Git boundaries are irrelevant;     a linked .trellis validates through its target but belongs to its container.     \"\"\"     try:         current = Path(start).resolve()     except (OSError, RuntimeError, ValueError):         # Never fall back to a lexical path after failed canonicalization.         return None     for candidate in (current, *current.parents):         marker = candidate / \".trellis\"         try:             if marker.is_dir() and (                 (marker / \"workflow.md\").is_file()                 or (marker / \"config.yaml\").is_file()                 or (marker / \"scripts\").is_dir()             ):                 return candidate         except OSError:             # An unreadable marker must not hide an accessible valid ancestor.             continue     return None"
  },
